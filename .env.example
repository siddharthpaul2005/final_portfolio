# Formspree Configuration
# Copy this file to .env and fill in your actual values
# Get your form ID from Formspree: https://formspree.io/

VITE_FORMSPREE_FORM_ID=your_formspree_form_id_here

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ALFRED chat (api/alfred.ts). Server-side only: never prefix with VITE_.
# Set it in Vercel > Project > Settings > Environment Variables too.
GROQ_API_KEY=
# Optional: any Groq chat model with tool use (default openai/gpt-oss-120b).
GROQ_MODEL=
